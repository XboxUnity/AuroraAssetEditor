import { Icon } from "../controls/icon.slint";
import { KindMarks } from "../model/kind_marks.slint";
import { Theme } from "../theme/theme.slint";

// The Assets cell: one mark per kind, the kind's icon when the console has it.
export component AssetMarks inherits HorizontalLayout {
    in property <KindMarks> marks;
    in property <color> present-color;

    spacing: Theme.table-mark-gap;
    alignment: start;

    for mark in [
        { state: marks.cover, icon: @image-url("../icons/cover.svg") },
        { state: marks.background, icon: @image-url("../icons/background.svg") },
        { state: marks.icon-banner, icon: @image-url("../icons/icon_banner.svg") },
        { state: marks.screenshots, icon: @image-url("../icons/screenshots.svg") },
    ]: Rectangle {
        width: Theme.icon-size;
        if mark.state == 1: Icon {
            y: (parent.height - self.height) / 2;
            source: mark.icon;
            colorize: present-color;
        }
        if mark.state != 1: Text {
            width: 100%;
            height: 100%;
            text: mark.state == 0 ? "…" : mark.state == 2 ? "·" : "?";
            color: mark.state == 3 ? Theme.error-text : Theme.text-muted;
            font-size: Theme.caption-font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
