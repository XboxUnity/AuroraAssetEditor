import { SlotView } from "../model/slot_view.slint";
import { Theme } from "../theme/theme.slint";
import { ImagePanel } from "image_panel.slint";

// The Cover and Background pages: one slot filling the body.
export component AssetPage inherits VerticalLayout {
    in property <SlotView> view;
    in property <image> placeholder;

    padding: Theme.body-padding;

    panel := ImagePanel {
        view: view;
        placeholder: placeholder;
    }
}
