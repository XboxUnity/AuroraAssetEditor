import { EditorModel } from "../model/editor_model.slint";
import { PreviewArea } from "../model/preview_area.slint";
import { Theme } from "../theme/theme.slint";
import { ImagePanel } from "image_panel.slint";

export component IconBannerPage inherits VerticalLayout {
    padding: Theme.body-padding;
    spacing: Theme.panel-gap;

    icon-panel := ImagePanel {
        view: EditorModel.icon;
        area: PreviewArea.icon;
        placeholder-area: PreviewArea.icon-placeholder;
    }
    banner-panel := ImagePanel {
        view: EditorModel.banner;
        area: PreviewArea.banner;
        placeholder-area: PreviewArea.banner-placeholder;
    }
}
