import { Icon } from "../controls/icon.slint";
import { Theme } from "../theme/theme.slint";

// The outcome of an action, on a card tinted by it, with a shadow like a menu's. The x in the top right corner, or
// a click anywhere on it, dismisses it before its time is up.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    callback dismissed();

    property <color> foreground: error ? Theme.error-text : Theme.text;
    property <color> state-colour: error ? Theme.error-text : Theme.toast-success;

    max-width: Theme.toast-max-width;
    background: error ? Theme.toast-error-background : Theme.toast-success-background;
    border-radius: Theme.dialog-radius;
    border-width: Theme.border-width;
    border-color: state-colour;
    drop-shadow-blur: Theme.menu-shadow-blur;
    drop-shadow-offset-y: Theme.menu-shadow-offset;
    drop-shadow-color: Theme.menu-shadow;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    accessible-live-region: error ? AccessibleLiveness.assertive : AccessibleLiveness.polite;
    accessible-action-default => {
        dismissed();
    }

    TouchArea {
        clicked => {
            dismissed();
        }
    }

    HorizontalLayout {
        padding-left: Theme.toast-padding-x;
        padding-right: Theme.toast-close-inset;
        padding-top: Theme.toast-padding-y;
        padding-bottom: Theme.toast-padding-y;
        spacing: Theme.toast-icon-gap;
        // In the middle of the toast, however many lines its text takes.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Icon {
                source: error ? @image-url("../icons/alert.svg") : @image-url("../icons/check.svg");
                colorize: state-colour;
            }
        }
        toast-text := Text {
            horizontal-stretch: 1;
            text: text;
            color: foreground;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        // Beside the first line, so the text wraps clear of it.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: start;
            close-button := Rectangle {
                width: Theme.toast-close-size;
                height: Theme.toast-close-size;
                border-radius: Theme.menu-row-radius;
                background: close-touch.has-hover ? Theme.pill-background : transparent;
                accessible-role: button;
                accessible-label: "Close";
                accessible-action-default => {
                    dismissed();
                }

                Icon {
                    source: @image-url("../icons/close.svg");
                    colorize: foreground;
                }

                close-touch := TouchArea {
                    clicked => {
                        dismissed();
                    }
                }
            }
        }
    }
}
