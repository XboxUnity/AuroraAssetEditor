import { Icon } from "../controls/icon.slint";
import { Theme } from "../theme/theme.slint";

export component SideBarItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    // Shown after the label when above 0.
    in property <int> count;
    in property <bool> selected;
    callback clicked();

    property <color> foreground: selected ? Theme.text-strong : Theme.row-text;

    height: Theme.sidebar-row-height;
    border-radius: Theme.sidebar-row-radius;
    background: selected ? Theme.chip-background : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => {
        clicked();
    }

    HorizontalLayout {
        padding-left: Theme.sidebar-row-padding-x;
        padding-right: count > 0 ? Theme.sidebar-count-row-padding-right : Theme.sidebar-row-padding-x;
        spacing: Theme.sidebar-icon-gap;
        alignment: start;
        Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            colorize: foreground;
        }
        HorizontalLayout {
            spacing: Theme.sidebar-count-gap;
            label-text := Text {
                horizontal-stretch: 0;
                text: label;
                color: foreground;
                overflow: elide;
                vertical-alignment: center;
            }
            if count > 0: count-text := Text {
                text: count;
                color: Theme.text-muted;
                font-size: Theme.caption-font-size;
                vertical-alignment: center;
            }
        }
    }

    TouchArea {
        clicked => {
            clicked();
        }
    }
}
