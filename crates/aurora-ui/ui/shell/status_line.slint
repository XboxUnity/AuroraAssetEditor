import { PillButton } from "../controls/pill_button.slint";
import { ShellModel } from "../model/shell_model.slint";
import { Theme } from "../theme/theme.slint";
import { BuildPill } from "build_pill.slint";

export component StatusLine inherits Rectangle {
    height: Theme.status-height;
    background: Theme.status-background;

    VerticalLayout {
        Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }

        HorizontalLayout {
            padding-left: Theme.status-padding-x;
            padding-right: Theme.status-padding-x;
            spacing: Theme.status-gap;
            // A running job's progress, set off from the status text by a rule as tall as its line.
            if ShellModel.progress-text != "": HorizontalLayout {
                horizontal-stretch: 0;
                spacing: Theme.status-gap;
                progress-text := Text {
                    text: ShellModel.progress-text;
                    color: Theme.text-muted;
                    font-size: Theme.caption-font-size;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: Theme.border-width;
                    Rectangle {
                        height: progress-text.preferred-height;
                        background: Theme.border;
                    }
                }
            }
            status-text := Text {
                horizontal-stretch: 1;
                text: ShellModel.status-text;
                color: ShellModel.status-is-error ? Theme.error-text : Theme.text-muted;
                font-size: Theme.caption-font-size;
                overflow: elide;
                vertical-alignment: center;
            }
            if ShellModel.bulk-stop-available: PillButton {
                text: "Stop";
                compact: true;
                clicked => {
                    ShellModel.stop-bulk();
                }
            }
            build-pill := BuildPill { }
        }
    }
}
