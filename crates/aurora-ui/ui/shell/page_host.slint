import { EditorModel } from "../model/editor_model.slint";
import { PageId } from "../model/page_id.slint";
import { PreviewArea } from "../model/preview_area.slint";
import { ShellModel } from "../model/shell_model.slint";
import { AssetPage } from "../pages/asset_page.slint";
import { ConsolePage } from "../pages/console_page.slint";
import { IconBannerPage } from "../pages/icon_banner_page.slint";
import { OnlinePage } from "../pages/online_page.slint";
import { ScreenshotsPage } from "../pages/screenshots_page.slint";

// The page area: the page the sidebar has selected.
export component PageHost inherits Rectangle {
    if ShellModel.page == PageId.cover: cover-page := AssetPage {
        width: 100%;
        height: 100%;
        view: EditorModel.cover;
        area: PreviewArea.cover;
        placeholder: @image-url("../placeholders/cover.png");
    }
    if ShellModel.page == PageId.background: background-page := AssetPage {
        width: 100%;
        height: 100%;
        view: EditorModel.background;
        area: PreviewArea.background;
        placeholder: @image-url("../placeholders/background.png");
    }
    if ShellModel.page == PageId.icon-banner: icon-banner-page := IconBannerPage {
        width: 100%;
        height: 100%;
    }
    if ShellModel.page == PageId.screenshots: screenshots-page := ScreenshotsPage {
        width: 100%;
        height: 100%;
    }
    if ShellModel.page == PageId.online: online-page := OnlinePage {
        width: 100%;
        height: 100%;
    }
    if ShellModel.page == PageId.console: console-page := ConsolePage {
        width: 100%;
        height: 100%;
    }
}
