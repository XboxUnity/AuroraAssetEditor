import { Theme } from "../theme/theme.slint";
import { Icon } from "icon.slint";

export component Chip inherits Rectangle {
    in property <string> text;
    // Drawn before the text, e.g. the connection chip's dot.
    in property <image> icon;
    in property <color> icon-color: Theme.chip-text;
    in property <bool> has-chevron;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 0;
    height: Theme.pill-height;
    border-radius: Theme.chip-radius;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    background: Theme.chip-background;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        clicked();
    }

    HorizontalLayout {
        padding-left: Theme.chip-padding-x;
        padding-right: Theme.chip-padding-x;
        spacing: Theme.icon-gap;
        if icon.width > 0: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            colorize: icon-color;
        }
        Text {
            text: text;
            color: Theme.chip-text;
            vertical-alignment: center;
        }
        if has-chevron: Icon {
            y: (parent.height - self.height) / 2;
            source: @image-url("../icons/chevron_down.svg");
            colorize: Theme.chip-text;
        }
    }

    TouchArea {
        enabled: enabled;
        clicked => {
            clicked();
        }
    }
}
