import { Theme } from "../theme/theme.slint";

export component MenuList inherits Rectangle {
    width: Theme.menu-width;
    height: self.preferred-height;
    background: Theme.bar-background;
    border-width: Theme.border-width;
    border-color: Theme.border;
    border-radius: Theme.menu-radius;
    drop-shadow-blur: Theme.menu-shadow-blur;
    drop-shadow-offset-y: Theme.menu-shadow-offset;
    drop-shadow-color: Theme.menu-shadow;

    // Keeps clicks between rows from reaching the backdrop that closes the menu.
    TouchArea { }

    VerticalLayout {
        padding: Theme.menu-padding;
        @children
    }
}
