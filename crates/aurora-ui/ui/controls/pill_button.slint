import { Theme } from "../theme/theme.slint";
import { Icon } from "icon.slint";

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> accent;
    // Drawn in the danger colour, for a confirmation that removes something.
    in property <bool> danger;
    in property <bool> has-chevron;
    in property <bool> enabled: true;
    // Status line size: caption font, the line's height.
    in property <bool> compact;
    // Reachable with Tab; Space or Return clicks it then. Dialog buttons use it.
    in property <bool> focusable;
    callback clicked();

    public function focus-button() {
        keys.focus();
    }

    property <bool> accent-look: accent && enabled;
    property <bool> danger-look: danger && enabled;
    property <color> foreground: danger-look ? Theme.danger-text : accent-look ? Theme.accent-text : enabled ? Theme.pill-text : Theme.disabled-button-text;

    horizontal-stretch: 0;
    height: compact ? self.preferred-height : Theme.pill-height;
    border-radius: Theme.pill-radius;
    background: danger-look ? Theme.danger : accent-look ? Theme.accent : enabled ? Theme.pill-background : Theme.disabled-button-background;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        clicked();
    }

    keys := FocusScope {
        enabled: focusable && enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                clicked();
                return accept;
            }
            reject
        }
    }

    if keys.has-focus: Rectangle {
        border-radius: Theme.pill-radius;
        border-width: Theme.focus-outline-width;
        border-color: Theme.focus-outline;
    }

    HorizontalLayout {
        padding-left: compact ? Theme.compact-pill-padding-x : Theme.pill-padding-x;
        padding-right: compact ? Theme.compact-pill-padding-x : Theme.pill-padding-x;
        spacing: Theme.icon-gap;
        alignment: center;
        if icon.width > 0: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            colorize: foreground;
        }
        if text != "": Text {
            text: text;
            color: foreground;
            font-size: compact ? Theme.caption-font-size : Theme.font-size;
            vertical-alignment: center;
        }
        if has-chevron: Icon {
            y: (parent.height - self.height) / 2;
            source: @image-url("../icons/chevron_down.svg");
            colorize: foreground;
        }
    }

    TouchArea {
        enabled: enabled;
        clicked => {
            clicked();
        }
    }
}
