import { Theme } from "../theme/theme.slint";
import { Icon } from "icon.slint";

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> accent;
    in property <bool> has-chevron;
    in property <bool> enabled: true;
    // Status line size: caption font, the line's height.
    in property <bool> compact;
    callback clicked();

    property <color> foreground: accent ? Theme.accent-text : Theme.pill-text;

    horizontal-stretch: 0;
    height: compact ? self.preferred-height : Theme.pill-height;
    border-radius: Theme.pill-radius;
    background: accent ? Theme.accent : Theme.pill-background;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        clicked();
    }

    HorizontalLayout {
        padding-left: compact ? Theme.compact-pill-padding-x : Theme.pill-padding-x;
        padding-right: compact ? Theme.compact-pill-padding-x : Theme.pill-padding-x;
        spacing: Theme.icon-gap;
        alignment: center;
        if icon.width > 0: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            colorize: foreground;
        }
        if text != "": Text {
            text: text;
            color: foreground;
            font-size: compact ? Theme.caption-font-size : Theme.font-size;
            vertical-alignment: center;
        }
        if has-chevron: Icon {
            y: (parent.height - self.height) / 2;
            source: @image-url("../icons/chevron_down.svg");
            colorize: foreground;
        }
    }

    TouchArea {
        enabled: enabled;
        clicked => {
            clicked();
        }
    }
}
