import { ChoiceView } from "choice_view.slint";
import { DialogKind } from "dialog_kind.slint";
import { PickerGameView } from "picker_game_view.slint";

export global DialogModel {
    in property <DialogKind> kind: DialogKind.none;
    in property <string> title;
    in property <string> text;
    in property <string> confirm-label;
    in property <bool> danger;
    // Return answers Cancel, and Cancel has the focus when the dialog opens.
    in property <bool> cancel-is-default;
    in property <[ChoiceView]> choices;
    // The form's boxes in the order the dialog draws them; each edit comes back through `edit-field`.
    in property <[string]> fields;
    in property <bool> accept-enabled;
    // The ID dialogs' list of the console's games; hidden while no console is set up or it listed none.
    in property <bool> picker-shown;
    in property <string> picker-filter;
    in property <[PickerGameView]> picker-games;
    // An index into `picker-games`, -1 for none.
    in property <int> picker-highlighted;
    // Shown in place of the games while they are listed; empty otherwise.
    in property <string> picker-note;
    in property <string> test-status;
    in property <bool> test-status-is-error;
    // 0 XboxUnity, 1 Internet Archive.
    in property <int> bulk-source-index;
    in property <bool> bulk-replace;
    // The About dialog: its lines come from the build information; an empty `about-run` hides the Run line.
    in property <string> about-heading;
    in property <string> about-credits;
    in property <string> about-commit;
    in property <string> about-built;
    in property <string> about-run;
    in property <bool> about-copied;
    in property <bool> about-notices-expanded;
    // One entry per line of the notices; empty while they are collapsed.
    in property <[string]> about-notices;

    callback accept();
    callback cancel();
    // The index into `choices`.
    callback choose(int);
    callback edit-field(int, string);
    callback edit-picker-filter(string);
    // Up and Down in the picker's box; Rust stops the highlight at the first and last game.
    callback move-picker-highlight(int);
    // The index into `picker-games`.
    callback pick-game(int);
    callback pick-highlighted-game();
    callback test-connection();
    callback set-bulk-source(int);
    callback set-bulk-replace(bool);
    callback copy-build-info();
    callback toggle-notices();
    callback open-log-folder();
}
