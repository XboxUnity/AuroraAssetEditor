// A place in the window that shows pictures, each resized by the view to the size it has there.
// The `-placeholder` areas show the placeholder art of an empty slot.
export enum PreviewArea {
    cover,
    background,
    icon,
    banner,
    screenshot,
    thumbnail,
    result,
    result-preview,
    cover-placeholder,
    background-placeholder,
    icon-placeholder,
    banner-placeholder,
    screenshot-placeholder,
}
