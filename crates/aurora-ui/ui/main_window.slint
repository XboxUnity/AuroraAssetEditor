import "fonts/Inter-Regular.ttf";
import "fonts/Inter-SemiBold.ttf";
import { ChoiceView } from "model/choice_view.slint";
import { ConsoleModel } from "model/console_model.slint";
import { DialogKind } from "model/dialog_kind.slint";
import { DialogModel } from "model/dialog_model.slint";
import { EditorModel } from "model/editor_model.slint";
import { GameRowView } from "model/game_row_view.slint";
import { KindMarks } from "model/kind_marks.slint";
import { MenuAction } from "model/menu_action.slint";
import { MenuId } from "model/menu_id.slint";
import { OnlineModel } from "model/online_model.slint";
import { PageId } from "model/page_id.slint";
import { PickerGameView } from "model/picker_game_view.slint";
import { PreviewArea } from "model/preview_area.slint";
import { PreviewModel } from "model/preview_model.slint";
import { ResultTileView } from "model/result_tile_view.slint";
import { ScreenshotTile } from "model/screenshot_tile.slint";
import { ShellModel } from "model/shell_model.slint";
import { SlotView } from "model/slot_view.slint";
import { ThemeOption } from "model/theme_option.slint";
import { ToastView } from "model/toast_view.slint";
import { DialogHost } from "dialogs/dialog_host.slint";
import { MenuOverlay } from "shell/menu_overlay.slint";
import { PageHost } from "shell/page_host.slint";
import { SideBar } from "shell/side_bar.slint";
import { StatusLine } from "shell/status_line.slint";
import { ToastStack } from "shell/toast_stack.slint";
import { TopBar } from "shell/top_bar.slint";
import { Theme } from "theme/theme.slint";

export {
    ChoiceView,
    ConsoleModel,
    DialogKind,
    DialogModel,
    EditorModel,
    GameRowView,
    KindMarks,
    MenuAction,
    MenuId,
    OnlineModel,
    PageId,
    PickerGameView,
    PreviewArea,
    PreviewModel,
    ResultTileView,
    ScreenshotTile,
    ShellModel,
    SlotView,
    Theme,
    ThemeOption,
    ToastView,
}

export component MainWindow inherits Window {
    title: ShellModel.window-title;
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    background: Theme.window-background;

    VerticalLayout {
        top-bar := TopBar {
            vertical-stretch: 0;
        }
        HorizontalLayout {
            vertical-stretch: 1;
            side-bar := SideBar { }
            PageHost {
                horizontal-stretch: 1;
            }
        }

        status-line := StatusLine {
            vertical-stretch: 0;
        }
    }

    MenuOverlay {
        width: 100%;
        height: 100%;
        menu-top: top-bar.height + Theme.menu-offset;
        open-button-x: top-bar.open-button-x;
        save-button-x: top-bar.save-button-x;
        game-chip-right: top-bar.game-chip-right;
        gear-button-right: top-bar.gear-button-right;
    }

    DialogHost {
        width: 100%;
        height: 100%;
    }

    // Over the dialogs too, so the outcome of a dialog's action shows; above the status line, which shows it as well.
    ToastStack {
        width: 100%;
        height: root.height - status-line.height;
    }
}
