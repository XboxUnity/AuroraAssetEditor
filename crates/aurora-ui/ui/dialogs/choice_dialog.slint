import { Theme } from "../theme/theme.slint";
import { DialogModel } from "../model/dialog_model.slint";
import { PillButton } from "../controls/pill_button.slint";
import { DialogFrame } from "dialog_frame.slint";
import { DialogText } from "dialog_text.slint";

// A question with one button per choice, and Cancel. Return cancels too, since no choice is the default.
// The app offers two choices at most; the buttons are written out, not repeated, so the first one can take
// the focus when Tab wraps around.
export component ChoiceDialog inherits DialogFrame {
    title: DialogModel.title;
    first-has-focus: first-choice-button.has-focus;
    last-has-focus: cancel-button.has-focus;
    focus-first => {
        first-choice-button.focus();
    }
    focus-last => {
        cancel-button.focus();
    }

    init => {
        self.take-focus();
    }

    DialogText {
        text: DialogModel.text;
    }

    HorizontalLayout {
        alignment: end;
        spacing: Theme.dialog-button-gap;

        first-choice-button := PillButton {
            text: DialogModel.choices[0].label;
            focusable: true;
            clicked => {
                DialogModel.choose(0);
            }
        }

        if DialogModel.choices.length > 1: second-choice-button := PillButton {
            text: DialogModel.choices[1].label;
            focusable: true;
            clicked => {
                DialogModel.choose(1);
            }
        }

        cancel-button := PillButton {
            text: "Cancel";
            focusable: true;
            clicked => {
                DialogModel.cancel();
            }
        }
    }
}
