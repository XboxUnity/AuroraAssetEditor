import { Theme } from "../theme/theme.slint";
import { DialogModel } from "../model/dialog_model.slint";

// The dimmed backdrop and the card every dialog sits on. Return accepts while the dialog allows it, or cancels
// when Cancel is the default, and Escape cancels, wherever the focus is inside the card. Tab and Shift+Tab wrap around inside the card, so the page
// below never gets the focus: each dialog names its first and last focusable element.
export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> card-width: Theme.dialog-width;
    in property <bool> first-has-focus;
    in property <bool> last-has-focus;
    callback focus-first();
    callback focus-last();

    background: Theme.dialog-backdrop;

    // For a dialog without a text box: the card's keys work without a click first.
    public function take-focus() {
        keys.focus();
    }

    // A box's Return ends here, since the box keeps the key to itself.
    public function submit() {
        if DialogModel.cancel-is-default {
            DialogModel.cancel();
        } else if DialogModel.accept-enabled {
            DialogModel.accept();
        }
    }

    // The window below takes no clicks while a dialog is open.
    TouchArea { }

    keys := FocusScope {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.card-width;
        height: card.preferred-height;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Tab && !event.modifiers.shift && (root.last-has-focus || self.has-focus) {
                root.focus-first();
                return accept;
            }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && (root.first-has-focus || self.has-focus) {
                root.focus-last();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                DialogModel.cancel();
                return accept;
            }
            if event.text == Key.Return {
                root.submit();
                return accept;
            }
            reject
        }

        card := Rectangle {
            background: Theme.dialog-background;
            border-radius: Theme.dialog-radius;
            border-width: Theme.border-width;
            border-color: Theme.border;
            drop-shadow-blur: Theme.menu-shadow-blur;
            drop-shadow-offset-y: Theme.menu-shadow-offset;
            drop-shadow-color: Theme.menu-shadow;
            accessible-role: groupbox;
            accessible-label: root.title;

            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.dialog-gap;

                Text {
                    text: root.title;
                    color: Theme.text-strong;
                    font-size: Theme.dialog-title-font-size;
                    font-weight: Theme.semibold-font-weight;
                    wrap: word-wrap;
                }

                @children
            }
        }
    }
}
