import { Theme } from "../theme/theme.slint";
import { TextField } from "../controls/text_field.slint";

export component FormFieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    out property <bool> has-focus: field.has-focus;
    callback edited(string);
    callback accepted();

    spacing: Theme.dialog-row-gap;
    forward-focus: field;

    public function focus-and-select-all() {
        field.focus-and-select-all();
    }

    Text {
        width: Theme.dialog-label-width;
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
    }

    field := TextField {
        horizontal-stretch: 1;
        value: root.value;
        accessible-label: root.label;
        edited(text) => {
            root.edited(text);
        }
        accepted => {
            root.accepted();
        }
    }
}
