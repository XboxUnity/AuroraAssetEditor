import { Theme } from "../theme/theme.slint";
import { DialogModel } from "../model/dialog_model.slint";
import { PillButton } from "../controls/pill_button.slint";
import { DialogFrame } from "dialog_frame.slint";
import { DialogText } from "dialog_text.slint";

export component MessageDialog inherits DialogFrame {
    title: DialogModel.title;

    first-has-focus: ok-button.has-focus;
    last-has-focus: ok-button.has-focus;
    focus-first => {
        ok-button.focus();
    }
    focus-last => {
        ok-button.focus();
    }

    init => {
        self.take-focus();
    }

    DialogText {
        text: DialogModel.text;
    }

    HorizontalLayout {
        alignment: end;

        ok-button := PillButton {
            text: "OK";
            accent: true;
            focusable: true;
            clicked => {
                DialogModel.accept();
            }
        }
    }
}
