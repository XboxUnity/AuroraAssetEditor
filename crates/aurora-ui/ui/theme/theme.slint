import { ShellModel } from "../model/shell_model.slint";

export global Theme {
    out property <bool> dark: ShellModel.dark;

    out property <color> window-background: dark ? #1b1d22 : #f5f6f8;
    out property <color> bar-background: dark ? #24272e : #ffffff;
    out property <color> sidebar-background: dark ? #202329 : #eef0f3;
    out property <color> status-background: dark ? #202329 : #eef0f3;
    out property <color> border: dark ? #2c2f36 : #dfe2e7;
    out property <color> text: dark ? #d8dbe2 : #1f2329;
    out property <color> text-strong: dark ? #ffffff : #0f172a;
    out property <color> text-muted: dark ? #7d8596 : #6b7280;
    out property <color> row-text: dark ? #b8bdc8 : #3c4250;
    out property <color> pill-background: dark ? #2e323a : #e6e8ec;
    out property <color> pill-text: dark ? #aaaabb : #4a5060;
    out property <color> accent: #3b82f6;
    out property <color> accent-text: #ffffff;
    out property <color> chip-background: dark ? #2e3a52 : #dbe6fb;
    out property <color> chip-text: dark ? #cfe0ff : #1e3a8a;
    out property <color> slot-background: dark ? #262a31 : #ffffff;
    out property <color> slot-border: dark ? #475063 : #b8c0cc;
    out property <color> slot-filled-border: #3b82f6;
    out property <brush> slot-filled-gradient: dark
        ? @linear-gradient(135deg, #2b3f63 0%, #1f2a3d 100%)
        : @linear-gradient(135deg, #e3ecfb 0%, #f2f6fd 100%);
    // The old placeholder art, drawn in one quiet colour on the empty slot.
    out property <color> placeholder-art: dark ? #585c61 : #d5dae2;
    out property <color> thumb-selected-outline: dark ? #ffffff : #0f172a;
    out property <color> error-text: dark ? #f87171 : #b91c1c;
    out property <color> danger: #dc2626;
    out property <color> link-ok: dark ? #22c55e : #16a34a;
    out property <color> link-failed: dark ? #f87171 : #b91c1c;

    out property <string> font-family: "Inter";
    out property <length> font-size: 12px;
    out property <length> caption-font-size: 11px;
    out property <length> page-title-font-size: 12px;
    out property <length> dialog-title-font-size: 13px;
    out property <int> semibold-font-weight: 600;

    out property <color> menu-shadow: #00000040;
    out property <float> disabled-opacity: 0.5;
    // A disabled button looks like a disabled neutral one, accent or not.
    out property <color> disabled-button-background: pill-background;
    out property <color> disabled-button-text: pill-text;
    out property <color> focus-outline: accent;
    out property <length> focus-outline-width: 1px;

    // Sizes from the layout B mockup (CSS line height 1.35 at 12 px gives the 20 px pills and 26 px rows).
    out property <length> window-width: 1024px;
    out property <length> window-height: 680px;
    out property <length> window-min-width: 760px;
    out property <length> window-min-height: 500px;
    out property <length> border-width: 1px;
    out property <length> icon-size: 14px;
    out property <length> icon-gap: 4px;
    out property <length> pill-height: 20px;
    out property <length> pill-radius: 4px;
    out property <length> pill-padding-x: 8px;
    out property <length> compact-pill-padding-x: 6px;
    out property <length> chip-radius: 12px;
    out property <length> chip-padding-x: 10px;
    out property <length> top-bar-height: 33px;
    out property <length> top-bar-padding-x: 10px;
    out property <length> top-bar-padding-y: 6px;
    out property <length> top-bar-gap: 8px;
    // The mockup's 118 px content box, 8 px padding on each side and the 1 px border.
    out property <length> sidebar-width: 135px;
    out property <length> sidebar-padding: 8px;
    out property <length> sidebar-row-height: 26px;
    out property <length> sidebar-row-padding-x: 6px;
    out property <length> sidebar-row-radius: 4px;
    out property <length> sidebar-icon-gap: 6px;
    out property <length> sidebar-count-gap: 3px;
    out property <length> sidebar-sources-gap: 10px;
    out property <length> body-padding: 12px;
    out property <length> status-height: 24px;
    out property <length> status-padding-x: 10px;
    out property <length> status-gap: 8px;
    out property <length> menu-width: 220px;
    out property <length> menu-radius: 6px;
    out property <length> menu-padding: 4px;
    out property <length> menu-offset: 2px;
    out property <length> menu-shadow-blur: 8px;
    out property <length> menu-shadow-offset: 2px;
    out property <length> menu-row-padding-x: 8px;
    out property <length> menu-row-padding-y: 5px;
    out property <length> menu-row-radius: 4px;
    out property <length> menu-separator-height: 9px;
    out property <length> body-gap: 8px;
    out property <length> header-gap: 6px;
    out property <length> slot-radius: 6px;
    out property <length> slot-dash-length: 4px;
    out property <length> slot-dash-gap: 3px;
    out property <length> slot-content-padding: 12px;
    out property <length> drop-hint-gap: 6px;
    out property <length> panel-gap: 12px;
    out property <length> thumb-width: 64px;
    out property <length> thumb-height: thumb-width * 562 / 1000;
    out property <length> thumb-gap: 6px;
    out property <length> thumb-selected-outline-width: 2px;
    out property <length> drag-threshold: 4px;
    out property <length> insertion-bar-width: 2px;

    // Text fields sit on the slot colour with the separator line as their edge.
    out property <color> field-background: slot-background;
    out property <color> field-border: border;
    out property <length> field-padding-x: 6px;

    out property <int> result-columns: 3;
    out property <length> result-gap: 6px;
    out property <length> result-panel-width: 110px;
    out property <float> result-aspect: 600 / 900;
    out property <length> result-label-padding: 6px;
    out property <length> result-check-inset: 4px;

    // The mockup's 11 px table text at line height 1.35 with 3 px cell padding, plus the 1 px row line.
    out property <length> table-row-height: 22px;
    out property <length> table-cell-padding-x: 6px;
    out property <length> table-id-column-width: 80px;
    out property <length> table-disc-column-width: 40px;
    out property <length> table-assets-column-width: 76px;
    out property <length> table-mark-gap: 2px;
    out property <length> table-chevron-gap: 2px;

    // The dialog card sits on the menus' colour; the backdrop dims the window by half in both themes.
    out property <color> dialog-backdrop: #00000080;
    out property <color> dialog-background: bar-background;
    out property <color> danger-text: #ffffff;
    out property <length> dialog-width: 360px;
    out property <length> connection-dialog-width: 420px;
    out property <length> about-dialog-width: 520px;
    // What the About card keeps for its title, padding and OK row when its body scrolls to fit the window.
    out property <length> about-frame-height: 150px;
    out property <length> notices-height: 200px;
    out property <length> notices-line-step: 16px;
    out property <length> dialog-radius: 8px;
    out property <length> dialog-padding: 16px;
    out property <length> dialog-gap: 12px;
    out property <length> dialog-row-gap: 6px;
    out property <length> dialog-button-gap: 8px;
    out property <length> dialog-label-width: 96px;
    // Long texts (many failed files) scroll inside the card above this height.
    out property <length> dialog-text-max-height: 320px;
    out property <length> scroll-indicator-width: 3px;
    out property <length> scroll-indicator-gap: 6px;
    out property <length> check-box-size: 14px;
    out property <length> check-box-radius: 3px;
    out property <length> check-label-gap: 6px;
    out property <length> check-focus-inset: 3px;
}
